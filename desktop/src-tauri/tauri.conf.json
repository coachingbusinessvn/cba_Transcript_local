{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ViTranscript",
  "version": "0.1.0",
  "identifier": "vn.coachingbusiness.vitranscript",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["desktop-remote"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/vitranscript-sidecar"
    ]
  },
  "plugins": {}
}
