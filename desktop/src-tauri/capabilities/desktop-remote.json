{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "desktop-remote",
  "description": "Remote capability for main window loading loopback sidecar UI",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "dialog:default",
    "opener:default"
  ]
}
